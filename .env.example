# Copy to .env to override defaults. Relative paths are resolved against the project root.
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/signvision.db

MODEL_ROOT=./models
ACTIVE_MODEL_ID=easy-sign-s3d
DOMAIN_PACK_ROOT=./domain-packs
ONNX_PROVIDERS=CPUExecutionProvider

# mediapipe | none — server-side hand detection for no_hands and gesture pauses
HAND_DETECTOR=mediapipe
HAND_LANDMARKER_PATH=./frontend/public/models/hand_landmarker.task

MAX_FRAME_SIZE_BYTES=1000000
MAX_WEBSOCKET_FPS=12
FRAME_BUFFER_SIZE=32
MAX_WEBSOCKET_CONNECTIONS=4

DEFAULT_CONFIDENCE_THRESHOLD=0.65
DEFAULT_STABILITY_COUNT=2
DEFAULT_COOLDOWN_MS=1200
PAUSE_MS=600

SAVE_RAW_FRAMES=false
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
